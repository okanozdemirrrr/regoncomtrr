# ============================================================
# Regon Teknoloji — Environment Variables
# Kopyala: cp .env.example .env.local
# .env.local asla Git'e dahil edilmez. Gerçek değerleri oraya yaz.
# ============================================================

# Supabase proje URL'si (Dashboard → Project Settings → API).
# SADECE SUNUCU, asla NEXT_PUBLIC_ yapma.
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon key. Portal istemciden tablo okumaz; yine de sunucu doğrulaması için tutulur.
# SADECE SUNUCU, asla NEXT_PUBLIC_ yapma.
SUPABASE_ANON_KEY=

# Service role key: RLS bypass. Yalnızca Route Handler / CLI.
# SADECE SUNUCU, asla NEXT_PUBLIC_ yapma.
SUPABASE_SERVICE_ROLE_KEY=

# Aktivasyon kodu / oturum imzalama pepper'ı (en az 32 karakter, rastgele).
# SADECE SUNUCU, asla NEXT_PUBLIC_ yapma.
ACTIVATION_PEPPER=

# Giriş denemesi rate-limit için IP HMAC tuzu (en az 32 karakter, rastgele).
# Ham IP saklanmaz.
# SADECE SUNUCU, asla NEXT_PUBLIC_ yapma.
IP_HASH_SALT=

# Gizli yönetici paneli şifresi (en az 12 karakter).
# SADECE SUNUCU, asla NEXT_PUBLIC_ yapma. Sitede /admin linki yok.
ADMIN_PASSWORD=

# Canonical site URL (sitemap, Open Graph). Sır içermez.
NEXT_PUBLIC_SITE_URL=https://regon.com.tr
